aws_region = "us-east-1"
name       = "client-webapp"
environment = "dev"

vpc_cidr                = "10.20.0.0/16"
availability_zone_count = 2

# NAT Gateways cost money. Set true for private subnet outbound internet access.
enable_nat_gateway = false
single_nat_gateway = true

# Replace or extend with VPN, Direct Connect, office, bastion, or trusted VPC CIDRs.
allowed_internal_cidrs = [
  "10.20.0.0/16"
]

client_webapp_port   = 8080
internal_webapp_port = 8080
db_port              = 5432

tags = {
  Owner = "platform"
}

