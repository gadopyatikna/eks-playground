aws_region = "us-east-1"
name       = "client-webapp"
environment = "dev"

vpc_cidr                = "10.20.0.0/16"
availability_zone_count = 2

# NAT Gateways cost money. Set true for private subnet outbound internet access.
enable_nat_gateway = false
single_nat_gateway = true

client_webapp_port = 8080
db_port            = 5432

# First apply creates this ECR repository. Push an immutable image tag, then set
# this value and apply again to create the Deployment and Service in EKS.
# client_webapp_image = "123456789012.dkr.ecr.us-east-1.amazonaws.com/client-webapp-dev-client-webapp:git-sha"
client_webapp_replicas = 2

# ACM certificate in the same region as the ALB. HTTPS terminates at the ALB.
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# EKS has a fixed control-plane hourly charge plus EC2 and EBS costs.
eks_kubernetes_version      = "1.36"
eks_endpoint_public_access  = true
eks_node_instance_type      = "t3.medium"
eks_node_disk_size          = 20
eks_node_desired_size       = 2
eks_node_min_size           = 1
eks_node_max_size           = 2

tags = {
  Owner = "platform"
}
